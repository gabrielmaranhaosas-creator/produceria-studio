{
  "manifestVersion": 5,
  "id": "br.com.produceria.bridge",
  "name": "Produceria Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridge",
      "label": { "default": "Produceria Bridge" },
      "minimumSize": { "width": 260, "height": 300 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 360, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["https://api.magnific.com"] }
  },
  "icons": []
}
