{
  "manifestVersion": 5,
  "id": "br.com.produceria.desdobra",
  "name": "Produceria Desdobra KV",
  "version": "1.4.2",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "desdobraPanel",
      "label": {
        "default": "Desdobra KV"
      },
      "minimumSize": {
        "width": 320,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 900,
        "height": 900
      }
    }
  ]
}
