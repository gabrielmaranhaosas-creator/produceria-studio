{
  "manifestVersion": 5,
  "id": "br.com.produceria.camadas",
  "name": "Produceria Camadas",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "camadasPanel",
      "label": { "default": "Camadas (nomes)" },
      "minimumSize": { "width": 230, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 560 },
      "preferredFloatingSize": { "width": 320, "height": 600 }
    }
  ]
}
