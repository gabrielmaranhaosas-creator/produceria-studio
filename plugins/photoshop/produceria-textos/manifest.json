{
  "manifestVersion": 5,
  "id": "br.com.produceria.textos",
  "name": "Produceria Textos",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "23.3.0" },
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "textosPanel",
      "label": { "default": "Textos (revisão)" },
      "minimumSize": { "width": 230, "height": 240 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 360 },
      "preferredFloatingSize": { "width": 300, "height": 440 }
    }
  ]
}
