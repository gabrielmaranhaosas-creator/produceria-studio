{
  "manifestVersion": 5,
  "id": "br.com.produceria.prova",
  "name": "Produceria Prova",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.2.0" },
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "provaPanel",
      "label": { "default": "Prova para aprovação" },
      "minimumSize": { "width": 230, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 520 },
      "preferredFloatingSize": { "width": 320, "height": 560 }
    }
  ]
}
